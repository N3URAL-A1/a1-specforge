{
  "description": "a1-specforge xprov consent hook (spec 016 FR-004): canonical consent questions only, pending-yes from the real answer, store and settings-forgery deny, fail closed.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "AskUserQuestion",
        "hooks": [{ "type": "command", "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/xprov-consent-hook.sh\" || exit 2" }]
      },
      {
        "matcher": "Edit|Write|NotebookEdit|MultiEdit",
        "hooks": [{ "type": "command", "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/xprov-consent-hook.sh\" || exit 2" }]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "AskUserQuestion",
        "hooks": [{ "type": "command", "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/xprov-consent-hook.sh\" || exit 2" }]
      }
    ]
  }
}
