{
  "permissions": {
    "deny": [
      "Edit(**/.a1/xprov-secret-allowlist.json)",
      "Write(**/.a1/xprov-secret-allowlist.json)",
      "Edit(~/.a1-xprov/allowlist-approvals.json)",
      "Write(~/.a1-xprov/allowlist-approvals.json)",
      "Edit(~/.a1-xprov/waivers.json)",
      "Write(~/.a1-xprov/waivers.json)",
      "Edit(~/.a1-xprov/permit-denials.json)",
      "Write(~/.a1-xprov/permit-denials.json)",
      "Edit(**/.a1/xprov.json)",
      "Write(**/.a1/xprov.json)",
      "Edit(**/.a1/phases/*/xreview/index.json)",
      "Write(**/.a1/phases/*/xreview/index.json)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/xprov-deny-allowlist-approve.sh\""
          }
        ]
      }
    ]
  }
}
