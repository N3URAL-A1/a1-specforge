              "target": {
                "type": "string",
                "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "action": {
                "const": "cancel"
              }
            },
            "required": [
              "action"
            ]
          },
          "then": {
            "required": [
              "target"
            ],
            "properties": {
              "target": {
                "type": "string",
                "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "action": {
                "const": "approve"
              }
            },
            "required": [
              "action"
            ]
          },
          "then": {
            "required": [
              "target_sha256"
            ]
          },
          "else": {
            "not": {
              "required": [
                "target_sha256"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "approved_via": {
                "const": "intent"
