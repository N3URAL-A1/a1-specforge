#!/usr/bin/env bash
# stub/launchctl — stands in for /bin/launchctl in cases/13-agent.sh. NEVER the
# real one. It is copied by the case into a per-sandbox directory and reads
# everything from files NEXT TO ITSELF, never from the environment (the agent
# starts it with a fixed env: README, "Stub processes read their mode from HOME,
# not from the environment" — the same reason, a different anchor):
#   argv.log    one line per call: <argc> TAB <arg1> TAB <arg2> ...  (appended)
#   mode        ok (default) | fail (bootstrap/bootout exit 5) | notloaded
#               (bootout exit 3, print exit 113)
#   print.txt   what `print` prints on stdout (absent: the job is not loaded)
# UNMEASURED: the text of print.txt and the exit codes of fail/notloaded are
# from memory of launchctl's usual output, not from a measurement on the
# owner's Mac (the suite never runs the real launchctl).
d="$(cd "$(dirname "$0")" && pwd)"
{ printf '%s' "$#"; for a in "$@"; do printf '\t%s' "$a"; done; printf '\n'; } >>"$d/argv.log"
mode=ok
[[ -f "$d/mode" ]] && mode="$(cat "$d/mode")"
case "$1" in
  print)
    if [[ "$mode" != notloaded && -f "$d/print.txt" ]]; then cat "$d/print.txt"; exit 0; fi
    echo "Could not find service" >&2
    exit 113 ;;
  bootout)
    [[ "$mode" == notloaded ]] && { echo "No such process" >&2; exit 3; }
    [[ "$mode" == fail ]] && { echo "Boot-out failed: 5: Input/output error" >&2; exit 5; }
    exit 0 ;;
  bootstrap)
    [[ "$mode" == fail ]] && { echo "Bootstrap failed: 5: Input/output error" >&2; exit 5; }
    exit 0 ;;
esac
exit 64
