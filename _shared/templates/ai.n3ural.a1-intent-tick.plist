<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  ai.n3ural.a1-intent-tick — the LaunchAgent that runs `a1-tools intent tick`
  every 30 s on the executor Mac (spec 011, Wave 11). A template: its
  double-braced placeholders are filled at install time (the ops half of Wave 11) from
  the installing shell: NODE and A1_TOOLS as absolute paths, HOME (launchd
  expands no ~), the vault root, and a PATH that holds the directories of
  node and claude. It carries no A1_INTENT_*
  variable: doctor fails on any override, here as in the environment (FR-046).
  The A1_HOST_ID block is optional: launchd reads no ~/.zshenv, so without it
  spec 010's writer gate falls back to the OS hostname and skips the hub and
  mirror writes of a hub that declares a1_writer_host: <A1_HOST_ID>. Render it
  with the value when A1_HOST_ID is set; when it is empty, delete every line
  from the opening marker comment to the closing marker comment (both are named
  A1_HOST_ID; the sed range is in _test-fixtures/a1-intent/cases/12-plist.sh).
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>ai.n3ural.a1-intent-tick</string>
  <key>ProgramArguments</key>
  <array>
    <string>{{NODE}}</string>
    <string>{{A1_TOOLS}}</string>
    <string>intent</string>
    <string>tick</string>
  </array>
  <key>StartInterval</key>
  <integer>30</integer>
  <key>RunAtLoad</key>
  <true/>
  <key>ProcessType</key>
  <string>Background</string>
  <key>StandardOutPath</key>
  <string>{{HOME}}/.a1-intents/agent.log</string>
  <key>StandardErrorPath</key>
  <string>{{HOME}}/.a1-intents/agent.log</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>{{PATH}}</string>
    <key>A1_VAULT_ROOT</key>
    <string>{{A1_VAULT_ROOT}}</string>
    <!--A1_HOST_ID-->
    <key>A1_HOST_ID</key>
    <string>{{A1_HOST_ID}}</string>
    <!--/A1_HOST_ID-->
  </dict>
</dict>
</plist>
